@model Modelo.Cadastros.Curso
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    Layout = "_LayoutIES";
}

<div class="card-block">

    <div class="card-header text-white bg-danger text-center h1">
        Registrando um novo curso
    </div>

    <div class="card-body">

        <form asp-action="Create"
              asp-controller="Curso"
              asp-area="Cadastros"
              method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Nome" class="control-label"></label>

                <input asp-for="Nome" class="form-control" />

                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DepartamentoID" class="control-label"></label>

                <select asp-for="DepartamentoID"
                        class="form-control"
                        asp-items="@(new SelectList(ViewBag.Departamentos, "DepartamentoID", "Nome"))">
                </select>

                <span asp-validation-for="DepartamentoID" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label class="control-label">Disciplinas</label>

                @foreach (var disciplina in ViewBag.Disciplinas)
                {
                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               name="disciplinaIDs"
                               value="@disciplina.DisciplinaID" />

                        <label class="form-check-label">
                            @disciplina.Nome
                        </label>
                    </div>
                }
            </div>

            <div class="form-group text-center h3">

                <input type="submit"
                       value="Registrar Curso"
                       class="btn btn-light" />

                <a asp-action="Index"
                   class="btn btn-info">
                    Retorno à listagem de cursos
                </a>

            </div>

        </form>

    </div>

    <div class="card-footer bg-dark text-center text-white">
        Informe os dados acima e/ou clique em um dos botões de ação
    </div>

</div>

@section ScriptPage {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}