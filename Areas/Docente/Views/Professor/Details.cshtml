@model Modelo.Docente.Professor

@{
    Layout = "_LayoutIES";
}

<div class="card-block">

    <div class="card-header text-white bg-secondary text-center h1">
        Exibindo um professor
    </div>

    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.ProfessorID)
            </dt>

            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.ProfessorID)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Nome)
            </dt>

            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Nome)
            </dd>

        </dl>

        <hr />

        <h3>Cursos ministrados</h3>

        @if (Model.CursosProfessores.Any())
        {
            <ul>
                @foreach (var cursoProfessor in Model.CursosProfessores)
                {
                    <li>
                        @cursoProfessor.Curso.Nome
                    </li>
                }
            </ul>
        }
        else
        {
            <p>Este professor ainda não está registrado em nenhum curso.</p>
        }

    </div>

    <div class="card-footer bg-info text-center">

         <a asp-area="Docente"
            asp-controller="Professor"
            asp-action="Index"
            class="btn btn-warning">
            Retornar à listagem de professores
        </a>

        <a asp-controller="Professor"
           asp-action="Index"
           class="btn btn-warning">
            Retornar à listagem de professores
        </a>

    </div>

</div>