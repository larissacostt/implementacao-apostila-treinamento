@model Modelo.Docente.Professor

@{
    Layout = "_LayoutIES";
}

@section Styles{
    <environment include="Development">
        <link rel="stylesheet" href="~/lib/font-awesome/css/all.css" />
    </environment>

    <environment exclude="Development">
        <link rel="stylesheet"
              href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.13.0/css/font-awesome.min.css"
              asp-fallback-href="~/lib/font-awesome/css/all.css"
              asp-fallback-test-class="sr-only"
              asp-fallback-test-property="position"
              asp-fallback-test-value="absolute" />
    </environment>
}

<div class="card-block">

    <div class="card-header text-white bg-secondary text-center h1">
        Exibindo um professor
    </div>

    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.ProfessorID)
            </dt>

            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.ProfessorID)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Nome)
            </dt>

            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Nome)
            </dd>

        </dl>

    </div>
    
    <div class="card-footer bg-info text-center text-white">

    <div class="col-3 d-flex flex-column align-items-center justify-content-center">

        <img class="img-thumbnail"
             src="@Url.Action("GetFoto", "Professor",
                 new { area = "Docente", id = Model.ProfessorID })" />

        <br />

        <a asp-action="Edit"
           class="btn btn-warning"
           asp-route-id="@Model.ProfessorID">
            Alterar
        </a>

        <a asp-action="Index"
           class="btn btn-warning">
            Retornar à listagem de professores
        </a>

        @Html.ActionLink(
            "Download",
            "DownloadFoto",
            "Professor",
            new { area = "Docente", id = Model.ProfessorID },
            null
        )

    </div>

</div>