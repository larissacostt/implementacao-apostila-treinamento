@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

<div class="text-center mt-5">
    @if (ViewBag.StatusCode == 404)
    {
        <h1 class="display-1 text-danger fw-bold">404</h1>
        <h2 class="mb-3">Ops! Página não encontrada</h2>
        <p class="lead">
            @(ViewBag.ErrorMessage ?? "A página ou recurso solicitado não foi encontrado no sistema.")
        </p>
    }
    else
    {
        <h1 class="text-danger">Erro</h1>
        <h2 class="text-danger">Ocorreu um erro ao processar a sua requisição.</h2>

        @if (Model?.ShowRequestId ?? false)
        {
            <p>
                <strong>Request ID:</strong> <code>@Model.RequestId</code>
            </p>
        }
    }

    <div class="mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
            Voltar para o Início
        </a>
    </div>
</div>